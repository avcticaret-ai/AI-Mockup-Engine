{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Difuzyon Modeli Yukle" }
  },

  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": ["1", 0],
      "shift": 3.0
    },
    "_meta": { "title": "ModelOrneklemeAuraFlow" }
  },

  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "_meta": { "title": "CLIP Yukle" }
  },

  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 0],
      "text": "__POSITIVE__"
    },
    "_meta": { "title": "Pozitif" }
  },

  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 0],
      "text": ""
    },
    "_meta": { "title": "Negatif (Z-Image'de cfg=1.0 oldugu icin etkisiz, bos birak)" }
  },

  "6": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1536,
      "batch_size": 1
    },
    "_meta": { "title": "Bos Gizli Goruntu" }
  },

  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler" }
  },

  "8": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "pixel_space"
    },
    "_meta": { "title": "VAE Yukle" }
  },

  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["8", 0]
    },
    "_meta": { "title": "VAE Kod Cozme" }
  },

  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "mockup_base/base"
    },
    "_meta": { "title": "Goruntuyu Kaydet" }
  }
}
